// Recurso Windows do executavel: icone e informacao de versao.
//
// O icone com id 1 e o que o Explorer e a barra de tarefas usam (o Windows
// escolhe o de menor id como icone da aplicacao).
//
// O bloco de versao e' de onde o Gestor de Tarefas tira o nome amigavel que
// mostra ao lado do processo -- sem ele aparece so' o nome do ficheiro.
// Escrito a mao e simples de proposito: o llvm-rc, que e' o compilador de
// recursos deste build, engasga-se com blocos VERSIONINFO mais elaborados.

#include <windows.h>

// Dois nomes para o mesmo icone, de proposito:
//   1         -- e por aqui que o Explorer e a barra de tarefas o encontram
//               (a shell usa o grupo de icones de menor id).
//   MAINICON  -- e o nome que o window_win.cpp do SDK procura ao registar a
//               classe da janela: LoadIconW(hinstance, L"MAINICON"). Sem este
//               a janela fica com o icone generico, mesmo com o do ficheiro
//               certo.
1 ICON "../assets/gh3recomp.ico"
MAINICON ICON "../assets/gh3recomp.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Guitar Hero 3 Recomp"
            VALUE "ProductName", "Guitar Hero 3 Recomp"
            VALUE "InternalName", "gh3recomp"
            VALUE "OriginalFilename", "Guitar Hero 3 Recomp.exe"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "ProductVersion", "1.0.0.0"
            VALUE "CompanyName", "luisxl15"
            VALUE "LegalCopyright", "Recompilacao nao oficial. Guitar Hero e marca da Activision."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
